config_version=5

[application]

config/name="MS2Godot"
run/main_scene="res://setup.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

QuitFinalizers="*res://scripts/QuitFinalizers.cs"
GammaGuard="*res://scripts/GammaGuard.cs"
FrameRateClock="*res://scripts/FrameRateClock.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="MS2Godot"
project/solution_directory=".."

[rendering]

rendering_device/driver.linuxbsd="vulkan"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4

[shader_globals]

ms2_ambient={
"type": "vec3",
"value": Vector3(0.8, 0.8, 0.8)
}
ms2_sun_color={
"type": "vec3",
"value": Vector3(0.8, 0.8, 0.8)
}
ms2_sun_ambient={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ms2_sun_specular={
"type": "vec3",
"value": Vector3(0.8, 0.8, 0.8)
}
ms2_hfog_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ms2_hfog={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ms2_lights={
"type": "sampler2D",
"value": ""
}
ms2_light_count={
"type": "float",
"value": 0.0
}
ms2_sun_dir={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
ms2_fog={
"type": "vec4",
"value": Vector4(5276, 20000, 1200, 0)
}
ms2_fog_color={
"type": "vec3",
"value": Vector3(0.78039217, 0.92941177, 1)
}
