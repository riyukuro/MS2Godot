<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ms2Godot</RootNamespace>
  </PropertyGroup>
  <!-- The in-game debug endpoint (game/devtools, src/Ms2.Devtools) exists only where MS2_DEVTOOLS is defined: every
       configuration except the release export. Its files are wrapped in #if MS2_DEVTOOLS, so a release assembly has none of it. -->
  <PropertyGroup Condition="'$(Configuration)' != 'ExportRelease' And '$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);MS2_DEVTOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'ExportRelease' And '$(Configuration)' != 'Release'">
    <Compile Include="../src/Ms2.Devtools/*.cs" LinkBase="devtools-lib" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Ms2.Formats/Ms2.Formats.csproj" />
    <ProjectReference Include="../src/Ms2.Swf/Ms2.Swf.csproj" />
    <ProjectReference Include="../src/Ms2.Net/Ms2.Net.csproj" />
    <ProjectReference Include="../src/Ms2.Audio/Ms2.Audio.csproj" />
    <ProjectReference Include="../src/Ms2.Video/Ms2.Video.csproj" />
    <ProjectReference Include="../src/Ms2.Navigation/Ms2.Navigation.csproj" />
    <ProjectReference Include="../src/Ms2.Quest/Ms2.Quest.csproj" />
    <ProjectReference Include="../src/Ms2.Avm2/Ms2.Avm2.csproj" />
    <ProjectReference Include="../src/Ms2.Ui/Ms2.Ui.csproj" />
    <ProjectReference Include="../src/Ms2.UiGen/Ms2.UiGen.csproj" />
  </ItemGroup>
</Project>
